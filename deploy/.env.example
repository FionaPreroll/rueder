# Settings for deploy/compose.yaml. Copy this file to .env and fill it in; .env
# stays out of the repository.

# The password of the database. It becomes part of an address, so letters and
# digits only, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=

# The image to run instead of building one from this repository, e.g. the one
# CI publishes for every change on main. Then `docker compose pull` fetches it.
# RUEDER_IMAGE=ghcr.io/fionapreroll/rueder:latest

# Where on this machine rueder listens. The reverse proxy that does TLS
# connects here; nothing else needs to.
# RUEDER_LISTEN=127.0.0.1:3000

# The header the reverse proxy puts the sender's address in, for the limits on
# requests and on wrong passwords. Set it once a proxy is in front of rueder,
# and only then.
# CLIENT_IP_HEADER=X-Forwarded-For

# Memory for PostgreSQL's cache. A quarter of the machine's memory is a common
# choice once there are millions of articles.
# POSTGRES_SHARED_BUFFERS=128MB

# How many megabytes of images the image proxy keeps.
# IMAGE_CACHE_MB=1024
# The secret for the addresses of the image proxy, 32 characters or more.
# Without one the server makes its own and keeps it next to the cache.
# IMAGE_PROXY_KEY=

# Internal networks feeds may be fetched from, e.g. a feed generator of your
# own. Nothing internal is reachable without this.
# FETCH_ALLOW_NETS=192.168.1.0/24, fd00::/8
# Start the server without fetching feeds.
# FETCH=off

# Login through an OpenID Connect provider (https only). The redirect address
# is the one of /api/oidc/callback as browsers reach it.
# OIDC_ISSUER=https://accounts.example
# OIDC_CLIENT_ID=rueder
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://reader.example/api/oidc/callback
