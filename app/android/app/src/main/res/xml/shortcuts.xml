<?xml version="1.0" encoding="utf-8"?>
<!-- A long press on the launcher icon: back to the start page, to change the
     server or whether the app looks for updates (MainActivity.SETUP). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="setup"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_setup_short"
        android:shortcutLongLabel="@string/shortcut_setup_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.fionapreroll.rueder"
            android:targetClass="io.github.fionapreroll.rueder.MainActivity">
            <extra android:name="io.github.fionapreroll.rueder.SETUP" android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
