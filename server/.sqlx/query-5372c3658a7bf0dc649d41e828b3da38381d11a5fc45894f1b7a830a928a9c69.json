  "query": "SELECT f.error_message AS \"message!\", count(*) AS \"feeds!\"\n           FROM feeds f\n           WHERE f.error_message IS NOT NULL\n             AND EXISTS (SELECT 1 FROM subscriptions s WHERE s.feed_id = f.id)\n           GROUP BY f.error_message",
