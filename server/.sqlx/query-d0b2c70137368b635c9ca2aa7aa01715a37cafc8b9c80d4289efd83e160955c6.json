  "query": "SELECT s.feed_id, s.folder_id, s.title AS own_title, f.title, f.feed_url, f.site_url,\n                f.icon_url\n         FROM subscriptions s JOIN feeds f ON f.id = s.feed_id\n         WHERE s.account_id = $1 ORDER BY s.position, s.feed_id",
