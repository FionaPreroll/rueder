  "query": "SELECT al.feed_id, al.seq, al.label_id\n           FROM labels l JOIN article_labels al ON al.label_id = l.id\n           WHERE l.account_id = $1\n             AND (al.feed_id, al.seq) IN (SELECT * FROM unnest($2::int4[], $3::int4[]))\n           ORDER BY l.position, l.id",
