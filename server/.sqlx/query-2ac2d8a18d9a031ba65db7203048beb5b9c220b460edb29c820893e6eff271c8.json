{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id, a.username, a.is_admin, s.second_factor, a.terms_version,\n                  s.last_seen_at < now() - $2::float8 * interval '1 second' AS \"stale!\"\n           FROM sessions s JOIN accounts a ON a.id = s.account_id\n           WHERE s.token_hash = $1 AND s.expires_at > now() AND a.disabled_at IS NULL",
