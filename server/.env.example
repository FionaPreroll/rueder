DATABASE_URL=postgres://postgres@127.0.0.1:5432/rueder

# Internal networks feeds may be fetched from, e.g. a feed generator of your own.
# Nothing internal is reachable without this.
# FETCH_ALLOW_NETS=192.168.1.0/24, fd00::/8
# Start the server without fetching feeds.
# FETCH=off
# A directory with lists of your own for the cleaning of article texts
# (blocked-links.txt, tracking-parameters.txt), in place of the ones in rules/.
# CLEANING_RULES_DIR=/etc/rueder/rules
# Where the image proxy keeps what it fetched, and how many megabytes of it.
# IMAGE_CACHE_DIR=/var/cache/rueder/images
# IMAGE_CACHE_MB=1024
# The secret for the addresses of the image proxy, 32 characters or more. Without
# one the server makes its own and keeps it in the cache directory.
# IMAGE_PROXY_KEY=
