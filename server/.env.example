DATABASE_URL=postgres://postgres@127.0.0.1:5432/rueder

# Internal networks feeds may be fetched from, e.g. a feed generator of your own.
# Nothing internal is reachable without this.
# FETCH_ALLOW_NETS=192.168.1.0/24, fd00::/8
# Start the server without fetching feeds.
# FETCH=off
# How fast feeds are fetched: up to FETCH_ROUND feeds every FETCH_EVERY seconds,
# FETCH_AT_ONCE at the same time (100, 30 and 8 if not set).
# FETCH_ROUND=100
# FETCH_AT_ONCE=8
# FETCH_EVERY=30
# A directory with lists of your own for the cleaning of article texts
# (blocked-links.txt, tracking-parameters.txt), in place of the ones in rules/.
# CLEANING_RULES_DIR=/etc/rueder/rules
# Where the image proxy keeps what it fetched, and how many megabytes of it.
# IMAGE_CACHE_DIR=/var/cache/rueder/images
# IMAGE_CACHE_MB=1024
# The secret for the addresses of the image proxy, 32 characters or more. Without
# one the server makes its own and keeps it in the cache directory.
# IMAGE_PROXY_KEY=
# Behind a reverse proxy: the header it puts the sender's address in, for the
# limits on requests and on wrong passwords. Without it all readers behind the
# proxy count as one sender. Leave it out if no proxy sets that header.
# CLIENT_IP_HEADER=X-Forwarded-For
# Login through an OpenID Connect provider (https only). The redirect address is
# the one of /api/oidc/callback as browsers reach it.
# OIDC_ISSUER=https://accounts.example
# OIDC_CLIENT_ID=rueder
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://reader.example/api/oidc/callback
# Mail to readers about their account, through an SMTP relay: smtps://, or
# smtp://…?tls=required; plain smtp:// only to one on this machine. The links
# in it lead to PUBLIC_URL.
# SMTP_URL=smtp://127.0.0.1:1025
# MAIL_FROM=rueder <rueder@localhost.test>
# PUBLIC_URL=http://localhost:3000
