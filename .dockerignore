# The image is built from server/, the client it takes from hardened-http/
# and web/, and nothing else.
*
!server
!hardened-http
!web

server/target
hardened-http/target
server/image-cache
server/fuzz/target
web/node_modules
web/build
web/coverage
web/.svelte-kit

# Settings and secrets never go into an image.
**/.env
**/.env.*
!**/.env.example
