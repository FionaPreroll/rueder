# The image is built from server/ and web/ and nothing else. The old system
# has build contexts of its own (backend/, frontend/).
*
!server
!web

server/target
server/image-cache
server/fuzz/target
web/node_modules
web/build
web/coverage
web/.svelte-kit

# Settings and secrets never go into an image.
**/.env
**/.env.*
!**/.env.example
