{
  "components": {
    "schemas": {
      "FeedItem": {
        "description": "An entry of a feed.",
        "properties": {
          "content_html": {
            "description": "The short text of the entry as a paragraph, and its image; the text\nholds no markup of the page.",
            "type": "string"
          },
          "date_published": {
            "description": "RFC 3339, if the page says when.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "The address of the entry, which is also its id.",
            "type": "string"
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "title",
          "content_html"
        ],
        "type": "object"
      },
      "JsonFeed": {
        "description": "A feed in JSON Feed 1.1 (<https://jsonfeed.org/version/1.1>).",
        "properties": {
          "_rssifier": {
            "$ref": "#/components/schemas/Made",
            "description": "How the entries were found: `recipe`, `json-ld`, `h-feed` or `guess`."
          },
          "home_page_url": {
            "description": "The page the feed is made of, as RSSifier writes it: a client keeps\nthis one, so that ways of writing the same page are one feed.",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/FeedItem"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "description": "Always `https://jsonfeed.org/version/1.1`.",
            "type": "string"
          }
        },
        "required": [
          "version",
          "title",
          "home_page_url",
          "items",
          "_rssifier"
        ],
        "type": "object"
      },
      "Limits": {
        "description": "What one token may do. A limit that is not set does not hold.",
        "properties": {
          "at_once": {
            "description": "Requests under way at the same time.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "fetches_per_hour": {
            "description": "Pages fetched per hour: the requests the cache could not answer, which\ncost the sites something.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "per_minute": {
            "description": "Requests per minute, from the cache or not.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Made": {
        "description": "How a feed was made, as an extension of JSON Feed.",
        "properties": {
          "source": {
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "What a problem looks like as JSON.",
        "properties": {
          "detail": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "type": {
            "description": "`token`, `address`, `blocked-host`, `no-items`, `needs-javascript`,\n`too-large`, `quota`, `busy`, `upstream` or `timeout`.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "detail"
        ],
        "type": "object"
      },
      "Usage": {
        "description": "What a token has used of its limits, for `GET /v1/usage`.",
        "properties": {
          "fetches": {
            "description": "Pages fetched in the last hour, as far as the limit counts them.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "name": {
            "type": "string"
          },
          "requests": {
            "description": "Requests in the last minute, as far as the limit counts them; without\na limit per minute always 0.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "under_way": {
            "description": "Requests under way now.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "name",
          "limits",
          "requests",
          "fetches",
          "under_way"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "token": {
        "description": "An app token, made with `rssifier token add`.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Makes feeds of web pages that have none. Every request but `/health` and `/openapi.json` names an app token of the operator in `Authorization: Bearer rsf_…`. Problems come as `application/problem+json`; their `type` is a fixed word, their `detail` fit to be shown to a reader.",
    "license": {
      "name": ""
    },
    "title": "RSSifier",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The server runs."
          }
        },
        "summary": "Says that the server runs. Without a token, and without numbers."
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi_json",
        "responses": {
          "200": {
            "description": "The description of RSSifier, OpenAPI 3.1."
          }
        },
        "summary": "This description."
      }
    },
    "/v1/feed": {
      "get": {
        "operationId": "feed",
        "parameters": [
          {
            "description": "The address of the page, `http` or `https`.",
            "in": "query",
            "name": "url",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/feed+json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonFeed"
                }
              }
            },
            "description": "The feed of the page."
          },
          "304": {
            "description": "The feed is the one of the `ETag` named."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`address`: not an address, or one inside the server's own network."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`token`: no token, or an unknown one."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`robots`: the site's `robots.txt` does not allow RSSifier the page; `blocked-host`: the operator does not fetch from the host."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`no-items`: the page lists nothing; `needs-javascript`: the page is made in the browser; `too-large`: the page is larger than 4 MB."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`quota`: a limit of the token; see `Retry-After`."
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`upstream`: the site answers with an error, or not at all, or its `robots.txt` cannot be read."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`busy`: the host of the page is asked too much right now; see `Retry-After`."
          },
          "504": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`timeout`: the site took too long."
          }
        },
        "security": [
          {
            "token": []
          }
        ],
        "summary": "Makes the feed of a page. The answer for a page is kept for a while (15\nminutes), for every token; within that time the page is not fetched again.\nWith `If-None-Match` and the `ETag` of the last answer, an unchanged feed\nis 304."
      }
    },
    "/v1/usage": {
      "get": {
        "operationId": "usage",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usage"
                }
              }
            },
            "description": "The token's limits and what it used."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`token`: no token, or an unknown one."
          }
        },
        "security": [
          {
            "token": []
          }
        ],
        "summary": "What the token has used of its limits. This request does not count."
      }
    }
  }
}
